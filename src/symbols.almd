// symbols — which of this grammar's nodes declare a name, which own methods,
// and which reference one: the rules the readers in gramide walk with.
// The tests are what those readers then say about a small Rust file.
import gramide.package_api
import gramide.lex
import gramide.parser
import gramide.tags
import self.lexer
import self.grammar

fn symbol_rules() -> package_api.SymbolRules = package_api.SymbolRules {
  declarations: [("function_declaration", "function"), ("method_declaration", "method"), ("method_signature", "method"), ("type_declaration", "type"), ("type_spec", "type"), ("let_declaration", "let"), ("variant", "variant"), ("field", "field"), ("impl", "impl"), ("mod", "mod"), ("macro_definition", "macro")],
  scopes: ["impl", "type_spec", "type_declaration"], namespaces: ["mod"], callables: ["function_declaration", "method_declaration", "method_signature"],
  lexical_owners: false, envelopes: ["item_envelope"], unnamed_envelopes: ["type_declaration"],
  arguments: "arguments", field_access: "field_access", type_mentions: ["type_name"]
}

test "a Rust method is named with the type it is implemented on" {
  let src = """mod inner {
    pub struct S { pub a: u8 }
    impl S { pub fn new() -> S { S { a: 0 } } }
    impl fmt::Display for S { fn fmt(&self) -> u8 { 0 } }
    pub trait T { fn go(&self) -> u8; }
}
"""
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags.outline(p.root, toks, source, p.names, "::", symbol_rules()), [
    "L1-6 mod inner",
    "  L2-2 type S",
    "    L2-2 field a",
    "  L3-3 impl S",
    "    L3-3 method S::new",
    // `impl Display for S` is an impl of S, so its methods are S's
    "  L4-4 impl fmt::Display for S",
    "    L4-4 method S::fmt",
    "  L5-5 type T",
    "    L5-5 method T::go",
  ])
}

test "a function in a plain module keeps its own name" {
  let src = "mod inner { pub fn free() -> u8 { 0 } }\n"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags.outline(p.root, toks, source, p.names, "::", symbol_rules()), ["L1-1 mod inner", "  L1-1 function free"])
}

test "a multi-byte character above a name does not shift the name" {
  // Every token offset counts bytes; `string.slice` counts characters. Cut a
  // name out of the source and this file gives `eDb {}` where it should give
  // `SpineDb`, one byte per non-ASCII character above it.
  let src = "//! ≥ and — and §\nimpl salsa::Database for SpineDb {}\n"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags.outline(p.root, toks, source, p.names, "::", symbol_rules()), ["L2-2 impl salsa::Database for SpineDb"])
}

test "a function written inside a method body is not a method of the type" {
  let src = "impl S { fn m() { fn helper() -> u8 { 0 } } }\n"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  assert_eq(tags.outline(p.root, toks, source, p.names, "::", symbol_rules()), ["L1-1 impl S", "  L1-1 method S::m", "    L1-1 function helper"])
}

test "flat Rust names preserve nested modules and trait display without changing bases" {
  let src = "mod outer { mod inner { impl PartialEq<S> for S { fn eq(&self) {} } fn free() {} } }"
  let source = bytes.from_string(src)
  let toks = lex.tokenize(src, lexer.spec()) |> result.map_err((e) => e.message)!
  let p = parser.parse(grammar.rules(), source, toks) |> result.map_err((f) => parser.format_failure(f))!
  let defs = list.filter(tags.of_tree(p.root, toks, source, p.names, "::", symbol_rules()), (t) => t.role == "def")
  assert_eq(list.map(defs, (t) => t.name), ["outer", "outer::inner", "PartialEq<S> for outer::inner::S", "outer::inner::S::eq", "outer::inner::free"])
  assert_eq(list.map(defs, (t) => t.base), ["outer", "inner", "S", "eq", "free"])
  assert_eq(list.map(defs, (t) => t.kind), ["mod", "mod", "impl", "method", "function"])
}
